window.saveArrayBuffer = (bufferThing) => {
    const link = document.createElement( 'a' );
    link.style.display = 'none';
    document.body.appendChild( link );
    new Uint8Array(bufferThing.byteLength);
    // for (let i = 0; i < result.data.length; i++) {
    //   raw[i] = result.data[i].charCodeAt(0);
    // }
    const blob = new Blob([new Uint8Array(bufferThing)], { type: 'application/octet-stream' } );	
    const objectURL = URL.createObjectURL( blob );

    link.href = objectURL;
    link.href = URL.createObjectURL( blob );
    link.download =  'data.arraybuffer';
    link.click();
};