///////note///////
it seems that all length 7 packets and the chat packets follow this path.
C() -> big_switch_func() -> packetFunc1() -> index.html.t.send()
-------code snippet view-------
C()
big_switch_func()
    v = i32_wrap_i64(ud);
    g = g - 32;
    ud = g[0]:long;
    call_indirect(g[2]:int, g[4]:int, g[6]:int, v); // SWITCH.PACKET.TYPE1
    ^^^^ calls packetFunc1()
packetFunc1()
    f_qj(1178048, b, f);
    j[0] = o + 1L;
    a[4]:short@1 = bigdata[1112516]:ushort@1;
    a[0]:int@1 = bigdata[1112512]:int@1;
    0_32(n, b, c + 6); // PACKETFUNC1.TSEND
    ^^^ calls t.send()
index.html.t.send()
////////////////


