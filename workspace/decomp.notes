    C()
    big_switch_func()
        v = i32_wrap_i64(ud);
        g = g - 32;
        ud = g[0]:long;
        call_indirect(g[2]:int, g[4]:int, g[6]:int, v); // SWITCH.PACKET.TYPE1
        ^^^^ calls packetFunc1()
    packetFunc1()
        f_qj(1178048, b, f);
        j[0] = o + 1L;
